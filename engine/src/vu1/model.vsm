; model.vsm — VU1 microprogram for object models (docs/03 §5.2 `model_skin`/`model_rigid`, docs/11).
; Consumes MODL batch packets (engine/src/world/model.h): up to 72 vertices, two node influences per
; vertex (rigid parts use the same node twice, weight 1), Gouraud lighting = ambient + one directional light.
; Same output format as bsp.vsm (ST+Q, RGBAQ, XYZF2 per vertex, GIF tag patched here) and the same
; post-divide clip test and collapse of rejected triangles (ADR-017).
;
; VU1 data memory (quadwords). Written by render/model_render.c: abs 0..11 once per object pass, the palette
; per batch, TOPS-relative data by each batch's own packet.
;   abs 0   screen scale (256, 224, Zmax, 1)         abs 1  screen offset (2048, 2048, 0, 0)
;   abs 2   uv scale (su, sv, 0, 0) per part         abs 3  GIF tag template per part
;   abs 4   fog (k, b, 0, 4080) as in bsp.vsm        abs 5  kS (1/G, 1/G, 2, 0)    abs 6  kB (0, 0, -1, 0)
;   abs 7   ambient (r, g, b, 0)  0..255 scale, 128 = 1.0    abs 8  sun colour (r, g, b, 0)
;   abs 9   (1/127, 1/32767, 255, 128)
;   abs 12 + 5*slot   palette entry: rows 0..3 = world-space node matrix x clip matrix (clip = x*r0 + y*r1 + z*r2 + r3),
;                     row 4 = light direction in the node's local frame (xyz); 24 slots, 12..131
;   TOPS+0   centre.xyz, scale (f32)            TOPS+1  x = vertex count n (s32)
;   TOPS+4   n x position  s16 x y z, w = palette slot of node 0
;   TOPS+76  n x s t, slot of node 1 (z), weight of node 0 (w, 0..32767)
;   TOPS+148 n x normal s8 x y z (127 = 1.0), w = 0
;   TOPS+440 output: GIF tag, then n x {ST+Q, RGBAQ, XYZF2}
; Input buffers: VIF BASE 136, OFFSET 220 (136..575); outputs at XTOP + 440 (576..1013). The engine sends
; BASE/OFFSET before the model pass and restores the BSP layout (BASE 16) after it.
;
; Skinning: clip = c1 + (c0 - c1) * w0, with c0, c1 the clip-space image of the decoded position under node
; 0 / node 1. Light: dot of the (unskinned) normal with node 0's local light direction.

        .macro MVERT k
        NOP                                 lq      VF12, 0(VI03)          ; raw position
        NOP                                 ilw.w   VI11, 0(VI03)          ; slot of node 0
        NOP                                 lq      VF13, 0(VI04)          ; s t slot1 weight
        NOP                                 ilw.z   VI12, 0(VI04)          ; slot of node 1
        NOP                                 lq      VF14, 0(VI05)          ; normal
        NOP                                 NOP
        NOP                                 NOP
        NOP                                 NOP
        NOP                                 iadd    VI13, VI11, VI11       ; palette address = 12 + 5 * slot
        NOP                                 iadd    VI13, VI13, VI13
        NOP                                 iadd    VI11, VI13, VI11
        NOP                                 iadd    VI13, VI12, VI12
        NOP                                 iadd    VI13, VI13, VI13
        NOP                                 iadd    VI12, VI13, VI12
        itof0   VF12, VF12                  NOP
        adda.xyz ACC, VF10, VF00            NOP                            ; position = centre + q * scale
        maddw.xyz VF12, VF12, VF10w         NOP
        maxw.w  VF12, VF00, VF00w           NOP                            ; w = 1
        NOP                                 lq      VF15, 12(VI11)
        NOP                                 lq      VF16, 13(VI11)
        NOP                                 lq      VF17, 14(VI11)
        NOP                                 lq      VF18, 15(VI11)
        NOP                                 lq      VF19, 16(VI11)         ; node 0 local light direction
        NOP                                 lq      VF20, 12(VI12)
        NOP                                 lq      VF21, 13(VI12)
        NOP                                 lq      VF22, 14(VI12)
        NOP                                 lq      VF23, 15(VI12)
        mulax   ACC, VF15, VF12x            NOP                            ; c0 = node 0 clip image
        madday  ACC, VF16, VF12y            NOP
        maddaz  ACC, VF17, VF12z            NOP
        maddw   VF24, VF18, VF12w           NOP
        mulax   ACC, VF20, VF12x            NOP                            ; c1 = node 1 clip image
        madday  ACC, VF21, VF12y            NOP
        maddaz  ACC, VF22, VF12z            NOP
        maddw   VF25, VF23, VF12w           NOP
        itof0   VF26, VF13                  NOP                            ; s t slot1 weight -> float
        muly.w  VF26, VF26, VF09            NOP                            ; weight / 32767
        sub     VF24, VF24, VF25            NOP                            ; c0 - c1
        mulaw   ACC, VF25, VF00w            NOP                            ; ACC = c1
        maddw   VF25, VF24, VF26w           NOP                            ; clip = c1 + (c0 - c1) * weight
        NOP                                 div     Q, VF00w, VF25w        ; Q = 1 / w
        itof0   VF14, VF14                  NOP                            ; normal -> float
        mulx.xyz VF14, VF14, VF09           NOP                            ; / 127
        mul.xyz VF30, VF14, VF19            NOP
        addy.x  VF30, VF30, VF30            NOP
        addz.x  VF30, VF30, VF30            NOP                            ; x = n . L
        max.x   VF30, VF30, VF00            NOP                            ; >= 0
        adda.xyz ACC, VF07, VF00            NOP
        maddx.xyz VF29, VF08, VF30          NOP                            ; colour = ambient + sun * (n.L)
        miniz.xyz VF29, VF29, VF09          NOP                            ; <= 255
        maxw.w  VF29, VF00, VF09w           NOP                            ; alpha = 128
        mul.xy  VF28, VF26, VF03            NOP                            ; uv * scale
        mulx.w  VF31, VF25, VF04            NOP                            ; fog: w * k + b, clamped
        addy.w  VF31, VF31, VF04            NOP
        maxz.w  VF31, VF31, VF04            NOP
        miniw.w VF31, VF31, VF04            NOP
        ftoi0   VF29, VF29                  NOP
        NOP                                 waitq
        mulq.xyz VF27, VF25, Q              NOP                            ; ndc
        adda.xyz ACC, VF06, VF00            NOP                            ; clip test on ndc: (x'/G, y'/G, 2z'-1)
        madd.xyz VF30, VF27, VF05           NOP
        clipw.xyz VF30, VF00                NOP
        mulq.xy VF28, VF28, Q               NOP                            ; s/w, t/w
        addq.z  VF28, VF00, Q               NOP                            ; q
        adda.xyz ACC, VF02, VF00            NOP
        madd.xyz VF27, VF27, VF01           NOP
        ftoi0.w VF31, VF31                  NOP
        ftoi4.xyz VF27, VF27                NOP
        NOP                                 sq      VF28, \k*3+0(VI07)
        NOP                                 sq      VF29, \k*3+1(VI07)
        NOP                                 sq.xyz  VF27, \k*3+2(VI07)
        NOP                                 sq.w    VF31, \k*3+2(VI07)
        NOP                                 iaddiu  VI03, VI03, 1
        NOP                                 iaddiu  VI04, VI04, 1
        NOP                                 iaddiu  VI05, VI05, 1
        .endm

        .global VU1Model_Entry
VU1Model_Entry:
        NOP                                 lq      VF01, 0(VI00)
        NOP                                 lq      VF02, 1(VI00)
        NOP                                 lq      VF03, 2(VI00)
        NOP                                 lq      VF04, 4(VI00)
        NOP                                 lq      VF05, 5(VI00)
        NOP                                 lq      VF06, 6(VI00)
        NOP                                 lq      VF07, 7(VI00)
        NOP                                 lq      VF08, 8(VI00)
        NOP                                 lq      VF09, 9(VI00)
        NOP                                 lq      VF11, 3(VI00)          ; GIF tag template
        NOP                                 xtop    VI02
        NOP                                 lq      VF10, 0(VI02)          ; centre, scale
        NOP                                 ilw.x   VI08, 1(VI02)          ; vertex count
        NOP                                 iaddiu  VI03, VI02, 4
        NOP                                 iaddiu  VI04, VI02, 76
        NOP                                 iaddiu  VI05, VI02, 148
        NOP                                 iaddiu  VI06, VI02, 440
        NOP                                 iaddiu  VI10, VI08, 0x7FFF
        NOP                                 iaddiu  VI10, VI10, 1          ; n | EOP
        NOP                                 sq      VF11, 0(VI06)
        NOP                                 isw.x   VI10, 0(VI06)
        NOP                                 iaddiu  VI07, VI06, 1
mtri_loop:
        MVERT 0
        MVERT 1
        MVERT 2
        NOP                                 fcand   VI01, 0x3FFFF
        NOP                                 isubiu  VI08, VI08, 3
        NOP                                 NOP
        NOP                                 ibeq    VI01, VI00, mtri_ok
        NOP                                 NOP
        NOP                                 sq.xyz  VF00, 2(VI07)          ; collapse the rejected triangle
        NOP                                 sq.xyz  VF00, 5(VI07)
        NOP                                 sq.xyz  VF00, 8(VI07)
mtri_ok:
        NOP                                 iaddiu  VI07, VI07, 9
        NOP                                 ibne    VI08, VI00, mtri_loop
        NOP                                 NOP
        NOP                                 NOP
        NOP                                 NOP
        NOP                                 xgkick  VI06
        NOP[E]                              NOP
        NOP                                 NOP
        .align 4
