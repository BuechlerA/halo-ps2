; tri.vsm — minimal VU1 microprogram: transform + project Gouraud triangles.
; Hand-scheduled (no VCL). Pattern after ps2sdk samples/draw/vu1 (AFL 2.0).
;
; VU1 data memory layout (qwords):
;   absolute 0..3      : local→screen matrix rows (unpacked once per draw, not via TOP)
;   TOP+0              : xyz = screen scale (float), w = vertex count (s32)
;   TOP+1              : GIF tag for the PRIM packet (NLOOP = count, REGS = RGBAQ, XYZ2)
;   TOP+2 .. +2+N-1    : vertices  (float x,y,z,1)
;   TOP+2+N .. +2+2N-1 : colours   (u32 r,g,b,a — PACKED RGBAQ layout)
;   TOP+2+2N ..        : output: GIF tag, then per vertex {RGBAQ, XYZ2}; XGKICKed
;
; Hazards respected: WAITQ before using Q; integer register used by the branch is
; written ≥ 2 instructions earlier; FMAC latency handled by hardware stalls.

        .vu
        .align 4
        .global VU1Tri_CodeStart
        .global VU1Tri_CodeEnd
VU1Tri_CodeStart:
        NOP                                 lq      VF01, 0(VI00)          ; matrix row 0
        NOP                                 lq      VF02, 1(VI00)          ; row 1
        NOP                                 lq      VF03, 2(VI00)          ; row 2
        NOP                                 lq      VF04, 3(VI00)          ; row 3
        NOP                                 xtop    VI02                   ; VI02 = current input buffer
        NOP                                 lq.xyz  VF05, 0(VI02)          ; screen scale
        NOP                                 ilw.w   VI07, 0(VI02)          ; vertex count
        NOP                                 lq      VF06, 1(VI02)          ; prim GIF tag
        NOP                                 iaddiu  VI03, VI02, 2          ; VI03 = vertex ptr
        NOP                                 NOP
        NOP                                 iadd    VI04, VI03, VI07       ; VI04 = colour ptr
        NOP                                 iadd    VI05, VI04, VI07       ; VI05 = kick address (output start)
        NOP                                 iaddiu  VI06, VI05, 0          ; VI06 = output write ptr
        NOP                                 sqi     VF06, (VI06++)         ; store GIF tag
        NOP                                 iadd    VI07, VI02, VI07       ; loop sentinel: count down to VI02
vertex_loop:
        NOP                                 lq      VF07, 0(VI03)          ; vertex
        NOP                                 lq      VF08, 0(VI04)          ; colour
        mulax   ACC, VF01, VF07x            NOP
        madday  ACC, VF02, VF07y            NOP
        maddaz  ACC, VF03, VF07z            NOP
        maddw   VF07, VF04, VF07w           NOP                            ; VF07 = clip-space vertex
        NOP                                 div     Q, VF00w, VF07w        ; Q = 1 / w
        NOP                                 waitq
        mulq.xyz  VF07, VF07, Q             NOP                            ; perspective divide
        mulaw.xyz ACC, VF05, VF00w          NOP                            ; ACC = scale
        madd.xyz  VF07, VF07, VF05          NOP                            ; vertex = vertex*scale + scale
        ftoi4.xyz VF07, VF07                NOP                            ; 12:4 fixed point for XYZ2
        NOP                                 sq      VF08, 0(VI06)          ; RGBAQ
        NOP                                 sq.xyz  VF07, 1(VI06)          ; XYZ2
        NOP                                 isubiu  VI07, VI07, 1
        NOP                                 iaddiu  VI03, VI03, 1
        NOP                                 iaddiu  VI04, VI04, 1
        NOP                                 iaddiu  VI06, VI06, 2
        NOP                                 ibne    VI07, VI02, vertex_loop
        NOP                                 NOP
        NOP                                 xgkick  VI05                   ; hand the packet to the GS (PATH1)
        NOP[E]                              NOP
        NOP                                 NOP
        .align 4
VU1Tri_CodeEnd:
